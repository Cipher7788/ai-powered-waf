# Copy to .env for local development. Replace every placeholder.
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
WAF_ADMIN_TOKEN=replace-with-a-long-random-admin-token
PORT=5000

# Logging
LOG_FILE=security.log

# Per-process in-memory rate limit (use shared storage for multi-worker distributed enforcement)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
